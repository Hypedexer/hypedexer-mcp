# HypeDexer MCP server configuration.
# Copy this file to `.env` (cp .env.example .env) - the server auto-loads it on
# startup. Already-set environment variables always win over the file, so an MCP
# client's `env` block still takes precedence. Or set these in your client config.

# --- Authentication -----------------------------------------------------------
# Your HypeDexer API key. Generate one at https://www.app.hypedexer.com/.
# WITHOUT a key, only the keyless `public` tool group (hl_public_*) is enabled,
# which is enough to smoke-test the server end to end.
HYPEDEXER_API_KEY=

# --- Tool selection -----------------------------------------------------------
# Which tool groups to load. A preset (public | core | all) or a comma list of
# groups (public,fills,markets,analytics,traders,liquidations,funding,vaults,
# hip3,hip4,builders,twaps,evm,streams,live,rpc,info). `streams` = indexed WS
# channels; `live` = Live (mirror) WS channels (order books, mids, fills);
# `rpc` = HyperEVM JSON-RPC (eth_*). All as bounded-window snapshots where
# streaming. `info` is the raw escape hatch and must be named explicitly.
# Default: all
HYPEDEXER_MCP_TOOLS=all

# --- Transport ----------------------------------------------------------------
# stdio (default, for Claude Desktop / Cursor) or http (hosted, streamable).
HYPEDEXER_MCP_TRANSPORT=stdio
HYPEDEXER_MCP_HTTP_PORT=3000
HYPEDEXER_MCP_HTTP_HOST=127.0.0.1

# --- HTTP transport security ---------------------------------------------------
# Bearer token clients must send as "Authorization: Bearer <token>".
# MANDATORY when HYPEDEXER_MCP_HTTP_HOST is not loopback; recommended always.
HYPEDEXER_MCP_HTTP_TOKEN=
# Extra hostnames accepted in the Host header (DNS-rebinding defense).
# Loopback names are always allowed. Comma list, e.g. mcp.hypedexer.com
HYPEDEXER_MCP_HTTP_ALLOWED_HOSTS=
# Extra full origins accepted in the Origin header besides allowed hosts.
# Comma list, e.g. https://app.hypedexer.com
HYPEDEXER_MCP_HTTP_ALLOWED_ORIGINS=
# Idle session lifetime (ms) before the reaper closes it, and the hard cap on
# concurrent sessions (new initializes get 503 past it).
HYPEDEXER_MCP_HTTP_SESSION_TTL_MS=600000
HYPEDEXER_MCP_HTTP_MAX_SESSIONS=100

# --- Tuning -------------------------------------------------------------------
HYPEDEXER_BASE_URL=https://api.hypedexer.com
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
# WSS endpoint for the `streams`/`live` groups. Derived from HYPEDEXER_BASE_URL
# when unset (https://host -> wss://host/ws); override only if the WS host differs.
HYPEDEXER_WS_URL=
# HyperEVM JSON-RPC for the `rpc` group. HTTP base + (optional) WSS for eth_subscribe.
HYPEDEXER_RPC_URL=https://rpc.hypedexer.com
HYPEDEXER_RPC_WS_URL=
HYPEDEXER_REQUEST_TIMEOUT_MS=30000
HYPEDEXER_MAX_RESPONSE_TOKENS=25000
HYPEDEXER_LOG_LEVEL=info
