{
  "name": "@hypedexer/mcp-server",
  "version": "2.1.0",
  "description": "Model Context Protocol server for the HypeDexer Hyperliquid data API: read-only market, trading, HIP-3/HIP-4, EVM and builder analytics tools, plus keyless Hyperliquid public tools.",
  "license": "MIT",
  "author": "hypedexer",
  "type": "module",
  "bin": {
    "hypedexer-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hyperliquid",
    "hypedexer",
    "claude",
    "ai",
    "trading",
    "perp"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "HYPEDEXER_MCP_LIVE=1 vitest run",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "smoke": "npm run build && bash scripts/inspector-smoke.sh",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "express": "^5.2.1",
    "hono": "^4.13.11",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.15",
      "qs": "^6.16.0",
      "postcss": "^8.5.23",
      "nanoid@<4": "^3.3.18",
      "esbuild@<0.25": "^0.25.0"
    }
  }
}
